{
  "id": "TD-011",
  "説明": "探索的テスト(CH-001〜005)で使える値の候補。セッションの中で変えてよい。",
  "正しくない入力": {
    "空欄": [""],
    "数字以外": ["abc", "-", "+", "１２３(全角数字)", "1e5", "¥100", "1,000"],
    "小数": ["30.5", "0.1", "3000000.99"],
    "負の値": ["-1", "-1000000"],
    "百分率の範囲外": ["-1", "101", "1000"],
    "極端に大きい値": ["999999999999", "9999999999999999999", "200(年齢)"],
    "年齢の前後関係の崩れ": [{"startAge": 70, "retirementAge": 65}, {"startAge": 70, "pensionStartAge": 65}, {"startAge": 65, "retirementAge": 65}, {"startAge": 66, "retirementAge": 65, "pensionStartAge": 65}]
  },
  "給与変更の崩れ": [
    {"年齢": "", "年収": ""},
    {"年齢": "abc", "年収": "-1"},
    [{"年齢": 40, "年収": 5000000}, {"年齢": 40, "年収": 6000000}],
    {"年齢": 25, "年収": 5000000, "注": "開始年齢30歳より前"},
    {"年齢": 70, "年収": 5000000, "注": "退職年齢65歳以降"}
  ],
  "使用例": {
    "ケース1": {"salary": 4000000, "retirementAge": 65, "investRate": 20, "interest": 4, "monthlyPension": 150000},
    "ケース2": {"salary": 4000000, "給与変更": [{"年齢": 30, "年収": 5000000}, {"年齢": 40, "年収": 7000000}], "investRate": 25, "interest": 4, "retirementAge": 65, "monthlyPension": 180000},
    "ケース3": {"salary": 6000000, "retirementAge": 55, "investRate": 30, "interest": 5, "pensionStartAge": 65, "gapIncome": 50000},
    "ケース4": {"salary": 10000000, "retirementAge": 70, "investRate": 40, "interest": 3, "monthlyPension": 200000},
    "注": "仕様書 使用例の値を円に直した。書いていない項目は起動直後の値"
  }
}
