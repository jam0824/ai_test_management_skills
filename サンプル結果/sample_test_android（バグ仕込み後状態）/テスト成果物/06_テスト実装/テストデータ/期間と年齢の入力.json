{
  "id": "TD-003",
  "説明": "期間の使い分けを確かめる入力。どの入力も「起動し直した直後」から、書いた項目だけを変える(書いていない項目は起動直後の値のまま)。開始年齢を55歳にしたのは、読む行数を減らして実行時間を短くするため(境界から離れた現役の月 55〜58歳 を残す)。",
  "入力": {
    "P": {
      "説明": "期間を見分けられる入力。退職60歳 < 年金65歳(差5歳)。3つの生活費がすべて違い、退職後収入は年金月額と違う正の値",
      "値": {"startAge": 55, "retirementAge": 60, "pensionStartAge": 65, "gapIncome": 50000, "salary": 3000000, "monthlyPension": 145000, "expenseCurrent": 150000, "expenseGap": 200000, "expenseRetired": 228000, "eventProb": 0},
      "境界から離れた月": {"現役": "55歳1月〜58歳12月", "退職後": "62歳1月〜63歳12月", "年金": "67歳1月〜最後の行"},
      "境界の前後1年": {"退職年齢": "59歳1月〜61歳12月", "年金開始年齢": "64歳1月〜66歳12月"}
    },
    "P_現役時生活費": {"もと": "P", "変える": {"expenseCurrent": 170000}},
    "P_給与": {"もと": "P", "変える": {"salary": 4000000}},
    "P_退職後生活費": {"もと": "P", "変える": {"expenseGap": 210000}},
    "P_退職後収入": {"もと": "P", "変える": {"gapIncome": 80000}},
    "P_老後生活費": {"もと": "P", "変える": {"expenseRetired": 250000}},
    "P_年金月額": {"もと": "P", "変える": {"monthlyPension": 160000}},
    "E": {
      "説明": "退職年齢 = 年金開始年齢(65歳・65歳)で、期間を見分けられる生活費と退職後収入",
      "値": {"startAge": 55, "retirementAge": 65, "pensionStartAge": 65, "gapIncome": 50000, "expenseCurrent": 150000, "expenseGap": 200000, "expenseRetired": 228000, "eventProb": 0},
      "境界の前後1年": "64歳1月〜66歳12月"
    },
    "E0": {
      "説明": "HTC-024 の基本の入力。退職年齢・年金開始年齢は初期値(65歳・65歳)",
      "値": {"startAge": 55, "eventProb": 0}
    },
    "E0_退職後収入": {"もと": "E0", "変える": {"gapIncome": 50000}},
    "E0_退職後生活費": {"もと": "E0", "変える": {"expenseGap": 300000}},
    "R70": {
      "説明": "退職年齢 > 年金開始年齢(70歳・65歳、仕様書 ケース4 に近い)",
      "値": {"startAge": 55, "retirementAge": 70, "pensionStartAge": 65, "gapIncome": 50000, "salary": 3000000, "monthlyPension": 145000, "expenseCurrent": 150000, "expenseGap": 200000, "expenseRetired": 228000, "eventProb": 0},
      "判定に使う月": {"現役": "55歳1月〜63歳12月", "年金": "72歳1月〜最後の行"}
    },
    "R66": {
      "説明": "退職年齢 = 年金開始年齢 + 1歳(66歳・65歳)",
      "もと": "R70", "変える": {"retirementAge": 66},
      "判定に使う月": {"現役": "55歳1月〜63歳12月", "年金": "68歳1月〜最後の行"}
    }
  },
  "期間の組": {
    "現役": "収入の種類が給与、生活費 = 現役時生活費(expenseCurrent)",
    "退職後": "収入の種類が退職後収入、生活費 = 退職〜年金開始期間の生活費(expenseGap)",
    "年金": "収入の種類が年金、生活費 = 老後生活費(expenseRetired)",
    "注": "収入の金額は手取りなどの計算が入りうる(Q-008、Q-021)ので、組の比べでは、同じ実行の境界から離れた月に出た (収入, 生活費) の値を、その期間の組とする"
  }
}
